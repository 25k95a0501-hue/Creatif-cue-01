# Server-side contact delivery. Configure these values in your deployment.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Required for production contact-form rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional AI assistant. Without this key, Cue uses its rule-based knowledge base.
OPENAI_API_KEY=
# Optional model override; default: gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
